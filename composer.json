{
  "name": "presentkim/play-sound-utils",
  "description": "Play any vanilla or custom sound to players in one line for axolotl-pm/PocketMine-MP",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "pocketmine/pocketmine-mp": "^5.0"
  },
  "require-dev": {
    "axolotl-pm/pocketmine-mp": "^5.51",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "kim\\present\\utils\\playsound\\": "src/kim/present/utils/playsound/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "kim\\present\\utils\\playsound\\tests\\": "tests/"
    }
  },
  "bin": [
    "tools/prune-vanilla-play-sounds-phar.php"
  ],
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
